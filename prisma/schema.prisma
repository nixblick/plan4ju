generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_ADMIN_URL")
}

// Better Auth core tables (user, session, account, verification).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Signs known-device cookies; changes on password change/reset and "sign out everywhere" (issue 8).
  securityStamp String   @default(dbgenerated("(gen_random_uuid())::text"))

  sessions    Session[]
  accounts    Account[]
  memberships FamilyMembership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Tenancy. Every family-scoped table carries familyId (RLS in migration).
model Family {
  id                String   @id @default(cuid())
  name              String
  timezone          String   @default("Europe/Berlin")
  // Optional modules (docs/module.md), off by default; only admins change them (DB trigger).
  moduleFlyers      Boolean  @default(false)
  moduleWaste       Boolean  @default(false)
  moduleMap         Boolean  @default(true)
  moduleWishes      Boolean  @default(true)
  moduleMindfulness Boolean  @default(true)
  moduleMeals       Boolean  @default(true)
  flyerLinks        Json     @default("[]")
  // Composite FK (wasteCalendarId, id) -> external_calendar(id, familyId) ON DELETE SET NULL exists in SQL only
  // (migration optional_modules): a Prisma relation over the primary key breaks family.create(). When running
  // `prisma migrate dev`, keep that constraint out of generated migrations.
  wasteCalendarId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships      FamilyMembership[]
  profiles         FamilyProfile[]
  invitations      FamilyInvitation[]
  tasks            Task[]
  birthdays        Birthday[]
  feedback         Feedback[]
  routines         Routine[]
  events           CalendarEvent[]
  calendars        ExternalCalendar[]
  recipes          Recipe[]
  mealSlots        MealSlot[]
  meals            Meal[]
  shops            Shop[]
  shoppingItems    ShoppingItem[]
  wishlists        Wishlist[]
  wishes           Wish[]
  images           Image[]
  wishReservations WishReservation[]
  mapCategories    MapCategory[]
  pois             Poi[]
  mindfulness      MindfulnessEntry[]
  mindfulShares    MindfulnessShare[]

  @@map("family")
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

model FamilyMembership {
  id        String     @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyRole @default(MEMBER)
  createdAt DateTime   @default(now())
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  mindfulnessEntries MindfulnessEntry[]
  mindfulnessShares  MindfulnessShare[]
  notifications      Notification[]
  notificationPrefs  NotificationPref[]
  calendarFeeds      CalendarFeed[]
  mindfulnessPrefs   MindfulnessPref[]
  declinesMade       TaskDecline[]      @relation("declinedBy")
  declinesReceived   TaskDecline[]      @relation("assignedBy")

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_membership")
}

// A person in the family. userId is null for children without login.
model FamilyProfile {
  id          String   @id @default(cuid())
  familyId    String
  userId      String?
  displayName String
  isChild     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assignments           TaskAssignment[]
  routineAssignments    RoutineAssignment[]
  occurrenceAssignments RoutineOccurrenceAssignment[]
  eventParticipations   CalendarEventParticipant[]
  mealCooks             MealCook[]
  wishlists             Wishlist[]
  mindfulnessEntries    MindfulnessEntry[]

  @@unique([familyId, userId])
  @@unique([id, familyId]) // target of the composite foreign keys that keep references inside one family
  @@index([familyId])
  @@map("family_profile")
}

model FamilyInvitation {
  id         String     @id @default(cuid())
  familyId   String
  email      String
  role       FamilyRole @default(MEMBER)
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_invitation")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

// Order matters: most urgent first (the list sorts by it).
enum TaskPriority {
  SOFORT
  DRINGEND
  ZEITNAH
  DEMNAECHST
  BEI_GELEGENHEIT
  IRGENDWANN
}

model Task {
  id              String       @id @default(cuid())
  familyId        String
  title           String
  description     String?
  dueDate         DateTime?    @db.Date
  dueTime         String? // local "HH:MM" in the family time zone
  priority        TaskPriority @default(ZEITNAH)
  /// Shown in the dashboard calendar (week). Off by default.
  showOnDashboard Boolean      @default(false)
  status          TaskStatus   @default(OPEN)
  doneAt          DateTime?
  archivedAt      DateTime? // archived tasks stay in the database but leave lists and the dashboard
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  family          Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assignments TaskAssignment[]
  declines    TaskDecline[]

  @@index([familyId, dueDate])
  @@map("task")
}

// n:m, zero assignments allowed.
model TaskAssignment {
  taskId    String
  profileId String
  familyId  String
  createdAt DateTime      @default(now())
  /// PENDING until the assigned person accepts; self-assignments and child profiles start ACCEPTED (issue 16).
  state        AssignmentState @default(PENDING)
  /// Who assigned; null for assignments from before 0.7.0.
  assignedById String?
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile   FamilyProfile @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([taskId, profileId])
  @@index([familyId])
  @@map("task_assignment")
}

enum AssignmentState {
  PENDING
  ACCEPTED
}

/// A declined assignment; tells the assigning person (lazy notification). RLS: only the two people involved.
model TaskDecline {
  id           String           @id @default(cuid())
  familyId     String
  taskId       String
  profileId    String
  declinedById String
  assignedById String
  createdAt    DateTime         @default(now())
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decliner     FamilyMembership @relation("declinedBy", fields: [familyId, declinedById], references: [familyId, userId], onDelete: Cascade, map: "task_decline_declined_membership_fkey")
  assigner     FamilyMembership @relation("assignedBy", fields: [familyId, assignedById], references: [familyId, userId], onDelete: Cascade, map: "task_decline_assigned_membership_fkey")

  @@index([familyId, assignedById, createdAt])
  @@map("task_decline")
}

// Birthday is a local date, not a UTC instant. birthYear null = year unknown.
model Birthday {
  id          String     @id @default(cuid())
  familyId    String
  name        String
  month       Int
  day         Int
  birthYear   Int?
  note        String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wishlists   Wishlist[]

  @@unique([id, familyId])
  @@index([familyId, month, day])
  @@map("birthday")
}

enum FeedbackKind {
  BUG
  IDEA
  OTHER
}

// Feedback from the test phase. Stored first, then mailed (mailedAt set on success).
model Feedback {
  id           String       @id @default(cuid())
  familyId     String
  userId       String
  kind         FeedbackKind
  message      String
  authorName   String?
  pagePath     String
  appVersion   String
  device       String
  screenWidth  Int?
  imageType    String?
  image        Bytes?
  mailedAt     DateTime?
  /// Delivery attempts so far; the job retries with backoff, after 5 mailFailedAt is set.
  mailAttempts Int          @default(0)
  mailNextAt   DateTime?
  mailFailedAt DateTime?
  createdAt    DateTime     @default(now())
  family       Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@map("feedback")
}

enum RoutineFreq {
  DAILY
  WEEKLY
  MONTHLY
}

enum RoutineStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// FIXED: all assignees of the routine are responsible for every occurrence.
// ROTATING: one assignee per occurrence, in the order of RoutineAssignment.position.
// PER_OCCURRENCE: nobody by default, each occurrence is assigned individually.
enum RoutineAssignMode {
  FIXED
  ROTATING
  PER_OCCURRENCE
}

enum OccurrenceStatus {
  OPEN
  DONE
  SKIPPED
}

// Recurring task. Days are local calendar dates (no time zone shift); see src/lib/recurrence.ts.
model Routine {
  id             String            @id @default(cuid())
  familyId       String
  title          String
  description    String?
  freq           RoutineFreq       @default(DAILY)
  interval       Int               @default(1)
  weekdays       Int[] // 0 = Monday .. 6 = Sunday
  monthDay       Int?
  startDate      DateTime          @db.Date
  endDate        DateTime?         @db.Date
  timeOfDay      String? // local "HH:MM"
  assignMode     RoutineAssignMode @default(FIXED)
  status         RoutineStatus     @default(ACTIVE)
  generatedUntil DateTime?         @db.Date // occurrences exist up to this day
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  family         Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assignments RoutineAssignment[]
  occurrences RoutineOccurrence[]

  @@index([familyId, status])
  @@map("routine")
}

// Default responsible persons of a routine; position gives the rotation order.
model RoutineAssignment {
  routineId String
  profileId String
  familyId  String
  position  Int           @default(0)
  routine   Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  profile   FamilyProfile @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([routineId, profileId])
  @@index([familyId])
  @@map("routine_assignment")
}

model RoutineOccurrence {
  id         String           @id @default(cuid())
  familyId   String
  routineId  String
  date       DateTime         @db.Date
  timeOfDay  String?
  status     OccurrenceStatus @default(OPEN)
  doneAt     DateTime?
  doneById   String?
  // true once someone assigned this occurrence by hand: routine changes must not touch it
  customized Boolean          @default(false)
  // the rule day this occurrence was moved away from; that day is not generated again
  movedFrom  DateTime?        @db.Date
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  routine    Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)

  assignments RoutineOccurrenceAssignment[]

  @@unique([routineId, date])
  @@index([familyId, date])
  @@map("routine_occurrence")
}

model RoutineOccurrenceAssignment {
  occurrenceId String
  profileId    String
  familyId     String
  occurrence   RoutineOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  profile      FamilyProfile     @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([occurrenceId, profileId])
  @@index([familyId])
  @@map("routine_occurrence_assignment")
}

// ---- Calendar (release 0.2, block 2) -------------------------------------------------------
enum CalendarKind {
  FILE // one-off ICS import
  SUBSCRIPTION // ICS address fetched by the server, read only
}

// Internal appointments. Timed ones are UTC instants; all-day ones are local calendar days (last day inclusive).
// Repetition works like routines (local days), the wall clock time is taken from startsAt in the family zone.
model CalendarEvent {
  id          String       @id @default(cuid())
  familyId    String
  title       String
  description String?
  location    String?
  allDay      Boolean      @default(false)
  startsAt    DateTime? // timed
  endsAt      DateTime? // timed
  startDate   DateTime?    @db.Date // all day: first day
  endDate     DateTime?    @db.Date // all day: last day, inclusive
  freq        RoutineFreq? // null = no repetition
  interval    Int          @default(1)
  weekdays    Int[] // 0 = Monday .. 6 = Sunday
  monthDay    Int?
  repeatUntil DateTime?    @db.Date
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  participants CalendarEventParticipant[]
  exceptions   CalendarEventException[]

  @@unique([id, familyId])
  @@index([familyId, startsAt])
  @@index([familyId, startDate])
  @@map("calendar_event")
}

model CalendarEventParticipant {
  eventId   String
  profileId String
  familyId  String
  event     CalendarEvent @relation(fields: [eventId, familyId], references: [id, familyId], onDelete: Cascade)
  profile   FamilyProfile @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([eventId, profileId])
  @@index([familyId])
  @@map("calendar_event_participant")
}

// One changed instance of a repeated event. `date` is the rule day (local) of the instance.
// cancelled = the instance is dropped; otherwise it is shown at the new time (timed: startsAt/endsAt,
// all day: startDate/endDate) and marked as moved.
model CalendarEventException {
  id        String        @id @default(cuid())
  familyId  String
  eventId   String
  date      DateTime      @db.Date
  cancelled Boolean       @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  startDate DateTime?     @db.Date
  endDate   DateTime?     @db.Date
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     CalendarEvent @relation(fields: [eventId, familyId], references: [id, familyId], onDelete: Cascade)

  @@unique([eventId, date])
  @@index([familyId])
  @@map("calendar_event_exception")
}

// An imported file or a subscription. `urlEnc` is the encrypted subscription address (a secret): it is
// never selected for the UI, never logged and never returned.
model ExternalCalendar {
  id             String       @id @default(cuid())
  familyId       String
  name           String
  colorIndex     Int          @default(0)
  kind           CalendarKind
  enabled        Boolean      @default(true)
  urlEnc         String?
  lastAttemptAt  DateTime?
  lastSuccessAt  DateTime?
  lastError      String? // fixed code, e.g. "status-404", never an address
  eventCount     Int          @default(0)
  truncated      Boolean      @default(false)
  refreshMinutes Int          @default(60) // 15, 60, 360 or 1440 (check constraint)
  failCount      Int          @default(0) // consecutive failed fetches
  pausedAt       DateTime? // set after MAX_FAILURES failures; only a manual fetch resumes
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  family         Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  events ExternalCalendarEvent[]

  @@unique([id, familyId])
  @@index([familyId])
  @@map("external_calendar")
}

model ExternalCalendarEvent {
  id          String           @id @default(cuid())
  familyId    String
  calendarId  String
  uid         String
  instanceKey String
  title       String
  description String?
  location    String?
  allDay      Boolean          @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  startDate   DateTime?        @db.Date
  endDate     DateTime?        @db.Date
  calendar    ExternalCalendar @relation(fields: [calendarId, familyId], references: [id, familyId], onDelete: Cascade)

  @@unique([calendarId, uid, instanceKey])
  @@index([familyId, startsAt])
  @@index([familyId, startDate])
  @@map("external_calendar_event")
}

// Recipe of a family. Steps and tags as text arrays; ingredients as rows so that single
// ingredients can later be moved to the shopping list. imageUrl and sourceUrl are links only
// (https), nothing foreign is mirrored.
model Recipe {
  id          String             @id @default(cuid())
  familyId    String
  title       String
  description String?
  servings    Int?
  prepMinutes Int?
  steps       String[]
  tags        String[]
  allergens   String?
  imageUrl    String?
  sourceUrl   String?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  meals       Meal[]
  images      Image[]

  @@unique([id, familyId])
  @@index([familyId, title])
  @@map("recipe")
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  familyId String
  recipeId String
  position Int
  quantity Float?
  unit     String?
  name     String
  recipe   Recipe  @relation(fields: [recipeId, familyId], references: [id, familyId], onDelete: Cascade)

  @@index([recipeId, position])
  @@map("recipe_ingredient")
}

/// A meal of the day ("Frühstück", "Mittag", "Abend" by default), configurable per family.
model MealSlot {
  id       String @id @default(cuid())
  familyId String
  name     String
  position Int
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  meals    Meal[]

  @@unique([familyId, name])
  @@unique([id, familyId])
  @@map("meal_slot")
}

/// One planned meal: a recipe or free text on a day and slot.
model Meal {
  id          String     @id @default(cuid())
  familyId    String
  date        DateTime   @db.Date
  slotId      String
  recipeId    String?
  text        String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  slot        MealSlot   @relation(fields: [slotId, familyId], references: [id, familyId], onDelete: Cascade)
  // NoAction (checked at statement end, so the family cascade works): deleteRecipe turns planned meals into free text first (SET NULL would null familyId too).
  recipe      Recipe?    @relation(fields: [recipeId, familyId], references: [id, familyId], onDelete: NoAction)
  cooks       MealCook[]

  @@unique([familyId, date, slotId])
  @@unique([id, familyId])
  @@index([familyId, date])
  @@map("meal")
}

model MealCook {
  mealId    String
  profileId String
  familyId  String
  meal      Meal          @relation(fields: [mealId, familyId], references: [id, familyId], onDelete: Cascade)
  profile   FamilyProfile @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([mealId, profileId])
  @@index([familyId])
  @@map("meal_cook")
}

/// A shop of the shopping list ("Supermarkt", "Drogerie", ...), ordered per family.
model Shop {
  id       String             @id @default(cuid())
  familyId String
  name     String
  position Int
  family   Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items    ShoppingItemShop[]

  @@unique([familyId, name])
  @@unique([id, familyId])
  @@map("shop")
}

/// One entry of the shared shopping list. fromRecipes keeps the titles of the recipes it came from
/// (a snapshot without foreign key, so the origin stays readable after a recipe is deleted).
model ShoppingItem {
  id          String             @id @default(cuid())
  familyId    String
  name        String
  quantity    Float?
  unit        String?
  note        String?
  done        Boolean            @default(false)
  doneAt      DateTime?
  clearedAt   DateTime?
  fromRecipes String[]
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  shops       ShoppingItemShop[]

  @@unique([id, familyId])
  @@index([familyId, done, clearedAt])
  @@map("shopping_item")
}

model ShoppingItemShop {
  itemId   String
  shopId   String
  familyId String
  item     ShoppingItem @relation(fields: [itemId, familyId], references: [id, familyId], onDelete: Cascade)
  shop     Shop         @relation(fields: [shopId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([itemId, shopId])
  @@index([familyId])
  @@index([shopId])
  @@map("shopping_item_shop")
}

enum WishVisibility {
  FAMILY
  PRIVATE
}

enum WishOccasion {
  ANY
  BIRTHDAY
  CHRISTMAS
  EASTER
  OTHER
}

/// A wish list of a family profile or of a person without profile (personName). Visibility and the
/// surprise mode are enforced in row level security too, see docs/wunschzettel.md.
model Wishlist {
  id          String         @id @default(cuid())
  familyId    String
  profileId   String?
  personName  String?
  title       String
  description String?
  visibility  WishVisibility @default(FAMILY)
  surprise    Boolean        @default(true)
  birthdayId  String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile     FamilyProfile? @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)
  /// The SQL deliberately uses ON DELETE SET NULL ("birthdayId") (migration wishlists); Prisma cannot express it.
  /// Drop any generated migration that changes this foreign key back.
  birthday    Birthday?      @relation(fields: [birthdayId, familyId], references: [id, familyId], onDelete: NoAction)
  wishes      Wish[]

  @@unique([id, familyId])
  @@index([familyId])
  @@map("wishlist")
}

/// One wish. received = the wishing person marked it as fulfilled (visible to everyone).
/// Reservations live in their own table so reserving never touches this row.
model Wish {
  id          String           @id @default(cuid())
  familyId    String
  listId      String
  title       String
  description String?
  url         String?
  imageUrl    String?
  priceCents  Int?
  priority    Int              @default(2)
  note        String?
  occasion    WishOccasion     @default(ANY)
  received    Boolean          @default(false)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  list        Wishlist         @relation(fields: [listId, familyId], references: [id, familyId], onDelete: Cascade)
  reservation WishReservation?
  images      Image[]

  @@unique([id, familyId])
  @@index([listId])
  @@map("wish")
}

/// Reservation of a wish by another member; hidden from the wishing person in surprise mode (RLS).
/// given = the giver marked it as given.
model WishReservation {
  id           String   @id @default(cuid())
  familyId     String
  wishId       String   @unique
  reservedById String
  given        Boolean  @default(false)
  createdAt    DateTime @default(now())
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wish         Wish     @relation(fields: [wishId, familyId], references: [id, familyId], onDelete: Cascade)

  @@unique([wishId, familyId])
  @@index([familyId])
  @@map("wish_reservation")
}

/// Map category (docs/karte.md). icon is a key of the built-in icon set (src/lib/map.ts), never markup.
/// Categories are deactivated, not deleted, so archived points keep their category.
model MapCategory {
  id          String   @id @default(cuid())
  familyId    String
  name        String
  description String?
  icon        String
  color       String   @default("#c2410c")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  pois        Poi[]

  @@unique([id, familyId])
  @@unique([familyId, name])
  @@map("map_category")
}

/// Point of interest. startDate/endDate (local days in the family time zone) make it temporary:
/// after endDate it is archived (archivedAt), never deleted. Permanent points have no endDate.
model Poi {
  id          String      @id @default(cuid())
  familyId    String
  categoryId  String
  name        String
  lat         Float
  lng         Float
  address     String?
  description String?
  note        String?
  url         String?
  imageUrl    String?
  rating      Int?
  startDate   DateTime?   @db.Date
  endDate     DateTime?   @db.Date
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category    MapCategory @relation(fields: [categoryId, familyId], references: [id, familyId], onDelete: NoAction)

  @@unique([id, familyId])
  @@index([familyId, archivedAt])
  @@map("poi")
}

enum MindfulnessTopic {
  FOOD
  SLEEP
  MOOD
  WORK
  LEISURE
  HEALTH
}

enum MindfulnessVisibility {
  PRIVATE
  SELECTED
  FAMILY
}

/// A mindfulness rating (1..5) of one person on one local day and topic. The author (createdById) is
/// the only one who can change it and who decides who sees it; "Nur ich" means the author. Adults write
/// for their own profile, parents also for child profiles without login. Row level security enforces
/// visibility with its own policies (not just the family scope), see docs/achtsamkeit.md.
/// HEALTH entries can never be visible to the whole family (DB check).
model MindfulnessEntry {
  id          String                @id @default(cuid())
  familyId    String
  profileId   String
  topic       MindfulnessTopic
  date        DateTime              @db.Date
  rating      Int
  note        String?
  visibility  MindfulnessVisibility @default(PRIVATE)
  /// Groups the rows of one submitted questionnaire (issue 15); older rows are their own check-in.
  checkinId   String                @default(cuid())
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile     FamilyProfile         @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)
  /// The author must be a member; leaving the family deletes the author's entries.
  author      FamilyMembership      @relation(fields: [familyId, createdById], references: [familyId, userId], onDelete: Cascade)
  shares      MindfulnessShare[]

  @@unique([id, familyId])
  @@unique([id, familyId, createdById])
  @@unique([profileId, topic, date, createdById])
  @@index([familyId, profileId, date])
  @@index([familyId, checkinId])
  @@map("mindfulness_entry")
}

/// A selected viewer of a SELECTED entry. ownerId repeats the entry author so that row level security
/// on this table never has to read mindfulness_entry (that would recurse); the composite foreign key
/// guarantees it matches. The viewer must be a member; leaving the family drops the share.
model MindfulnessShare {
  id       String           @id @default(cuid())
  familyId String
  entryId  String
  ownerId  String
  userId   String
  family   Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entry    MindfulnessEntry @relation(fields: [entryId, familyId, ownerId], references: [id, familyId, createdById], onDelete: Cascade)
  viewer   FamilyMembership @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([familyId, userId])
  @@map("mindfulness_share")
}

/// Who sees new mindfulness check-ins of this user; copied into each row on submit (issue 15).
model MindfulnessPref {
  familyId   String
  userId     String
  visibility MindfulnessVisibility @default(PRIVATE)
  viewerIds  String[]              @default([])
  updatedAt  DateTime              @default(now()) @updatedAt
  membership FamilyMembership      @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Cascade, map: "mindfulness_pref_membership_fkey")

  @@id([familyId, userId])
  @@map("mindfulness_pref")
}

enum NotificationKind {
  TASK_DUE
  ROUTINE_DUE
  BIRTHDAY
  ASSIGNED
  DECLINED
}

/// In-app notification of one user in one family (RLS: own rows only). docs/benachrichtigungen.md
model Notification {
  id         String           @id @default(cuid())
  familyId   String
  userId     String
  kind       NotificationKind
  dedupeKey  String
  title      String
  link       String
  createdAt  DateTime         @default(now())
  readAt     DateTime?
  membership FamilyMembership @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Cascade, map: "notification_membership_fkey")

  @@unique([familyId, userId, dedupeKey])
  @@index([familyId, userId, readAt])
  @@map("notification")
}

model NotificationPref {
  familyId     String
  userId       String
  tasks        Boolean          @default(true)
  routines     Boolean          @default(true)
  birthdays    Boolean          @default(true)
  assignments  Boolean          @default(true)
  emailDigest  Boolean          @default(false)
  digestSentOn DateTime?        @db.Date
  updatedAt    DateTime         @default(now()) @updatedAt
  membership   FamilyMembership @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Cascade, map: "notification_pref_membership_fkey")

  @@id([familyId, userId])
  @@map("notification_pref")
}

/// Private ICS feed of one user; only the token hash is stored.
model CalendarFeed {
  id         String           @id @default(cuid())
  familyId   String
  userId     String
  tokenHash  String           @unique
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime?
  membership FamilyMembership @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Cascade, map: "calendar_feed_membership_fkey")

  @@unique([familyId, userId])
  @@map("calendar_feed")
}

/// Uploaded picture of a recipe or a wish (exactly one), metadata removed; served only via /api/bild/<id>.
model Image {
  id          String   @id @default(cuid())
  familyId    String
  recipeId    String?
  wishId      String?
  mime        String
  size        Int
  data        Bytes
  createdById String
  createdAt   DateTime @default(now())
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipe      Recipe?  @relation(fields: [recipeId, familyId], references: [id, familyId], onDelete: Cascade)
  wish        Wish?    @relation(fields: [wishId, familyId], references: [id, familyId], onDelete: Cascade)

  @@unique([id, familyId])
  @@unique([recipeId])
  @@unique([wishId])
  @@index([familyId])
  @@map("image")
}

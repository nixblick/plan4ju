generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_ADMIN_URL")
}

// Better Auth core tables (user, session, account, verification).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships FamilyMembership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Tenancy. Every family-scoped table carries familyId (RLS in migration).
model Family {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/Berlin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships FamilyMembership[]
  profiles    FamilyProfile[]
  invitations FamilyInvitation[]
  tasks       Task[]
  birthdays   Birthday[]
  feedback    Feedback[]
  routines    Routine[]

  @@map("family")
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

model FamilyMembership {
  id        String     @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyRole @default(MEMBER)
  createdAt DateTime   @default(now())
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_membership")
}

// A person in the family. userId is null for children without login.
model FamilyProfile {
  id          String   @id @default(cuid())
  familyId    String
  userId      String?
  displayName String
  isChild     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assignments           TaskAssignment[]
  routineAssignments    RoutineAssignment[]
  occurrenceAssignments RoutineOccurrenceAssignment[]

  @@unique([familyId, userId])
  @@index([familyId])
  @@map("family_profile")
}

model FamilyInvitation {
  id         String     @id @default(cuid())
  familyId   String
  email      String
  role       FamilyRole @default(MEMBER)
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_invitation")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  familyId    String
  title       String
  description String?
  dueDate     DateTime?    @db.Date
  dueTime     String? // local "HH:MM" in the family time zone
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(OPEN)
  doneAt      DateTime?
  archivedAt  DateTime? // archived tasks stay in the database but leave lists and the dashboard
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assignments TaskAssignment[]

  @@index([familyId, dueDate])
  @@map("task")
}

// n:m, zero assignments allowed.
model TaskAssignment {
  taskId    String
  profileId String
  familyId  String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile   FamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([taskId, profileId])
  @@index([familyId])
  @@map("task_assignment")
}

// Birthday is a local date, not a UTC instant. birthYear null = year unknown.
model Birthday {
  id          String   @id @default(cuid())
  familyId    String
  name        String
  month       Int
  day         Int
  birthYear   Int?
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, month, day])
  @@map("birthday")
}

enum FeedbackKind {
  BUG
  IDEA
  OTHER
}

// Feedback from the test phase. Stored first, then mailed (mailedAt set on success).
model Feedback {
  id          String       @id @default(cuid())
  familyId    String
  userId      String
  kind        FeedbackKind
  message     String
  authorName  String?
  pagePath    String
  appVersion  String
  device      String
  screenWidth Int?
  imageType   String?
  image       Bytes?
  mailedAt    DateTime?
  createdAt   DateTime     @default(now())
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@map("feedback")
}

enum RoutineFreq {
  DAILY
  WEEKLY
  MONTHLY
}

enum RoutineStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// FIXED: all assignees of the routine are responsible for every occurrence.
// ROTATING: one assignee per occurrence, in the order of RoutineAssignment.position.
// PER_OCCURRENCE: nobody by default, each occurrence is assigned individually.
enum RoutineAssignMode {
  FIXED
  ROTATING
  PER_OCCURRENCE
}

enum OccurrenceStatus {
  OPEN
  DONE
  SKIPPED
}

// Recurring task. Days are local calendar dates (no time zone shift); see src/lib/recurrence.ts.
model Routine {
  id             String            @id @default(cuid())
  familyId       String
  title          String
  description    String?
  freq           RoutineFreq       @default(DAILY)
  interval       Int               @default(1)
  weekdays       Int[] // 0 = Monday .. 6 = Sunday
  monthDay       Int?
  startDate      DateTime          @db.Date
  endDate        DateTime?         @db.Date
  timeOfDay      String? // local "HH:MM"
  assignMode     RoutineAssignMode @default(FIXED)
  status         RoutineStatus     @default(ACTIVE)
  generatedUntil DateTime?         @db.Date // occurrences exist up to this day
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  family         Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assignments RoutineAssignment[]
  occurrences RoutineOccurrence[]

  @@index([familyId, status])
  @@map("routine")
}

// Default responsible persons of a routine; position gives the rotation order.
model RoutineAssignment {
  routineId String
  profileId String
  familyId  String
  position  Int           @default(0)
  routine   Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  profile   FamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([routineId, profileId])
  @@index([familyId])
  @@map("routine_assignment")
}

model RoutineOccurrence {
  id         String           @id @default(cuid())
  familyId   String
  routineId  String
  date       DateTime         @db.Date
  timeOfDay  String?
  status     OccurrenceStatus @default(OPEN)
  doneAt     DateTime?
  doneById   String?
  // true once someone assigned this occurrence by hand: routine changes must not touch it
  customized Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  routine    Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)

  assignments RoutineOccurrenceAssignment[]

  @@unique([routineId, date])
  @@index([familyId, date])
  @@map("routine_occurrence")
}

model RoutineOccurrenceAssignment {
  occurrenceId String
  profileId    String
  familyId     String
  occurrence   RoutineOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  profile      FamilyProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([occurrenceId, profileId])
  @@index([familyId])
  @@map("routine_occurrence_assignment")
}

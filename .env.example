# Placeholders only. Real values live in ~/.secrets/plan4ju/ (local) or the server environment.
# Local development: copy to .env (gitignored) and replace every CHANGE_ME.

# docker-compose.yml
POSTGRES_DB=plan4ju
POSTGRES_OWNER_USER=plan4ju_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
DB_PORT=55432
MAILPIT_UI_PORT=58025
MAILPIT_SMTP_PORT=51025

# App connection: restricted role, row level security applies.
DATABASE_URL=postgresql://plan4ju_app:CHANGE_ME@localhost:55432/plan4ju
# Migrations and administration only (table owner). Never used for request handling.
DATABASE_ADMIN_URL=postgresql://plan4ju_owner:CHANGE_ME@localhost:55432/plan4ju

BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
SMTP_URL=smtp://localhost:51025
MAIL_FROM="Plan4JU <noreply@example.test>"
# Feedback from the widget is mailed here (plain text, screenshot attached). Empty = only stored in the database.
FEEDBACK_MAIL_TO=feedback@example.org

# Docker (profile "app"): port published on 127.0.0.1 for the reverse proxy. SMTP_URL must reach a real
# mail server there (not Mailpit on localhost). DB passwords should be URL-safe (letters, digits).
APP_PORT=3000
# Proxies in front of the app that append to X-Forwarded-For (client IP for rate limits). 0 = no proxy.
TRUSTED_PROXY_HOPS=1
# Only "true" if the proxy always overwrites X-Real-IP; then it is used when X-Forwarded-For is missing.
TRUSTED_REAL_IP=false
# Optional analytics snippet: only emitted when ANALYTICS_SCRIPT_URL is set.
# ANALYTICS_SCRIPT_URL=https://stats.example.test/tracker.js
# ANALYTICS_SITE=plan.example.test
# Optional AI recipe ideas ("Rezeptidee"). Off unless both are set; only the wish fields are sent.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=CHANGE_ME
# AI_MODEL=claude-sonnet-5-5
